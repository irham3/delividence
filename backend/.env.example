# Kosongkan GOOGLE_CLOUD_PROJECT untuk mode lokal (config.LOCAL=True):
# antrean lewat HTTP langsung ke worker, state ke file JSON di .localdata/,
# tanpa Firestore/Pub/Sub sungguhan. Lihat app/config.py. Ini tidak
# memengaruhi panggilan Gemini -- itu diatur terpisah di bawah.

# ROLE menentukan app mana yang diserve dari image yang sama: api | worker
ROLE=api

# --- Google Cloud (isi hanya kalau menyambung ke project sungguhan) -------
GOOGLE_CLOUD_PROJECT=
PUBSUB_TOPIC=delividence-runs

# 06 §2. Model terverifikasi -- lihat docs/10-KEPUTUSAN-DAN-VERIFIKASI.md
GEMINI_MODEL=gemini-3.5-flash
# Kandidat stabil, berurutan, setelah model utama menghabiskan retry SDK.
# Kosongkan untuk menonaktifkan fallback; pisahkan beberapa model dengan koma.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_MODEL_TIMEOUT_SECONDS=45
GOOGLE_CLOUD_LOCATION=asia-southeast2

# Default sekarang Gemini Developer API (free tier, tanpa kartu/billing GCP)
# -- isi GEMINI_API_KEY dari https://aistudio.google.com/apikey. Ganti
# GOOGLE_GENAI_USE_VERTEXAI=TRUE (dan isi GOOGLE_CLOUD_PROJECT di atas) kalau
# billing GCP sudah aktif dan mau pakai Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_API_KEY=

# 02 §8 / 06 §6. Firebase Auth (owner login) -- proyek Firebase yang
# terhubung ke GOOGLE_CLOUD_PROJECT di atas. Aktifkan dulu di Firebase
# Console (atau Firebase Management API) sebelum diisi di sini.
FIREBASE_PROJECT_ID=

# --- Lokal ------------------------------------------------------------------
WORKER_URL=http://127.0.0.1:8081
# Next.js pindah ke :3001 otomatis kalau :3000 sedang dipakai project lain di
# mesin yang sama -- keduanya diizinkan sekalian supaya CORS tidak mendadak
# menolak pas itu terjadi ("Disallowed CORS origin").
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
