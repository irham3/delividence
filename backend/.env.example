# Kosongkan GOOGLE_CLOUD_PROJECT untuk mode lokal (config.LOCAL=True):
# antrean lewat HTTP langsung ke worker, state ke file JSON di .localdata/,
# tanpa kredensial GCP apa pun. Lihat app/config.py.

# ROLE menentukan app mana yang diserve dari image yang sama: api | worker
ROLE=api

# --- Google Cloud (isi hanya kalau menyambung ke project sungguhan) -------
GOOGLE_CLOUD_PROJECT=
PUBSUB_TOPIC=delividence-runs

# 06 §2. Model terverifikasi -- lihat docs/10-KEPUTUSAN-DAN-VERIFIKASI.md
GEMINI_MODEL=gemini-3.7-flash
GOOGLE_CLOUD_LOCATION=asia-southeast2
# Wajib TRUE: mencegah ADK fallback ke Gemini Developer API/API key
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- Lokal ------------------------------------------------------------------
WORKER_URL=http://127.0.0.1:8081
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
